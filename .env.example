# PostgreSQL
PLAYGRADE_DB_NAME=playgrade
PLAYGRADE_DB_USER=playgrade
PLAYGRADE_DB_PASSWORD=playgrade_dev_password
PLAYGRADE_DB_HOST=db
PLAYGRADE_DB_PORT=5432

# API
# Replace this value before deploying outside local development.
PLAYGRADE_SECRET_KEY=local-development-secret-change-me
PLAYGRADE_CORS_ORIGINS=http://localhost:3000
PLAYGRADE_MAX_UPLOAD_BYTES=2097152

# This URL is used by the browser, so it must be reachable from the host.
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000

